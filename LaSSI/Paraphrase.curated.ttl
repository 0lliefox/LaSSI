# [P2]
para:WeatherThunder
    a para:ParaphraseConcept ;
    rdfs:label "weather_thunder" ;
    rdfs:comment "e.g. 'Thunder is forecast for Newcastle this afternoon.' vs 'Thunderstorms are forecast for Newcastle this afternoon.'  Source: Met Office DataHub weather code 30 'Thunder' (datahub.metoffice.gov.uk/support/faqs); 'thunderstorm' as the everyday name is general knowledge." .

para:phrase_thunder
    a para:ParaphrasePhrase ;
    rdfs:label "thunder" ;
    para:memberOf para:WeatherThunder ;
    para:form "name" .

