    a para:ParaphrasePhrase ;
    rdfs:label "thunderstorms" ;
    para:memberOf para:WeatherThunder ;
    para:form "name" .

# [P3]
para:WeatherSnowNoun
    a para:ParaphraseConcept ;
    rdfs:label "weather_snow_noun" ;
    rdfs:comment "e.g. 'Light snow is forecast for Newcastle overnight.' vs 'Light snowfall is forecast for Newcastle overnight.'  Mirrors WeatherPrecipitationNoun (rain/rainfall).  Source: Met Office DataHub weather codes 22-27 (snow); 'snowfall' is general knowledge." .

para:phrase_snow
    a para:ParaphrasePhrase ;
    rdfs:label "snow" ;
    para:memberOf para:WeatherSnowNoun ;
    para:form "name" .

para:phrase_snowfall
    a para:ParaphrasePhrase ;
    rdfs:label "snowfall" ;
    para:memberOf para:WeatherSnowNoun ;
    para:form "name" .

