# [P1]
para:AntiSocialBehaviour
    a para:ParaphraseConcept ;
    rdfs:label "anti_social_behaviour" ;
    rdfs:comment "e.g. 'Anti-social behaviour was reported near the station.' vs 'Antisocial behaviour (ASB) was reported near the station.'  Source: Police.uk crime category 'Anti-social behaviour' (data.police.uk/api/crime-categories); spelling variants are general knowledge." .

para:phrase_anti-social_behaviour
    a para:ParaphrasePhrase ;
    rdfs:label "anti-social behaviour" ;
    para:memberOf para:AntiSocialBehaviour ;
    para:form "name" .

